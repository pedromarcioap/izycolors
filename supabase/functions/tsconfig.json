{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"],
      "jsr:@supabase/functions-js/edge-runtime.d.ts": ["./deno.d.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "./deno.d.ts"
  ]
}
