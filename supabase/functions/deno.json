{
    "compilerOptions": {
        "lib": [
            "deno.ns",
            "deno.unstable",
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": false
    },
    "imports": {
        "@supabase/supabase-js": "npm:@supabase/supabase-js@2"
    },
    "fmt": {
        "lineWidth": 100,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ]
        }
    }
}